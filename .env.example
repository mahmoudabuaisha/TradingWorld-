# ─────────────────────────────────────────────────────────────
# TradingWorld — environment template (copy to .env, never commit .env)
# ─────────────────────────────────────────────────────────────

# ── API server ───────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
# 32+ random chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ── Database (PostgreSQL + TimescaleDB) ──────────────────────
DATABASE_URL=postgresql://tradingworld:tradingworld@localhost:5432/tradingworld?schema=public
REDIS_URL=redis://localhost:6379

# ── Zone outcome tracker (docs/04 §6.1 → AI-01) ──────────────
OUTCOME_ENABLED=true
OUTCOME_HORIZON_BARS=120        # closed bars after detection before a zone that was not invalidated is labelled
OUTCOME_INTERVAL_SECONDS=300
OUTCOME_SCAN=                   # analysed every run so the dataset grows without viewers, e.g. XAUUSD:15m,EURUSD:15m,US100:1h

# ── Repositories (docs/05 → DB-02) ───────────────────────────
# auto → PostgreSQL via Prisma when DATABASE_URL is set (run: pnpm --filter @tradingworld/db migrate:deploy), else memory.
REPOSITORIES=auto

# ── Candle store + backfill job (docs/03 → DATA-02) ──────────
# auto → timescale when DATABASE_URL is set, else memory. The store sits behind every budgeted provider.
CANDLE_STORE=auto
# The maintenance job (catch-up → gap repair → derive higher timeframes) is explicit opt-in.
BACKFILL_ENABLED=false
BACKFILL_BASE_TIMEFRAME=1m      # the only series pulled from providers; every higher timeframe is derived from it
BACKFILL_BARS=20000             # ≈ 14 days of 1m per instrument
BACKFILL_PAGE_SIZE=5000         # bars per provider request (Twelve Data max 5000)
BACKFILL_INTERVAL_MINUTES=15    # catch-up + gap repair cadence
BACKFILL_AGGREGATE_SECONDS=60   # re-derive the current buckets of each timeframe
BACKFILL_INCLUDE_DEMO=false     # also fill demo-served instruments (local testing only)
BACKFILL_SYMBOLS=               # optional CSV filter, e.g. XAUUSD,EURUSD

# ── Market data (docs/03-data-providers.md) ──────────────────
# Routing by asset class: <class>=<provider>, classes: forex metal crypto index stock commodity,
# providers: demo (synthetic, no key) · binance (public crypto, unlicensed) · twelvedata · polygon (licensed, keys).
# Anything not routed — or routed to a provider without a key — is served by demo and reported in /health warnings.
# Example for production with a Twelve Data plan:
#   MARKET_DATA_ROUTES=forex=twelvedata,metal=twelvedata,index=twelvedata,commodity=twelvedata,crypto=twelvedata
MARKET_DATA_ROUTES=
# Legacy single switch (used only when MARKET_DATA_ROUTES is empty): demo | binance | twelvedata | polygon
MARKET_DATA_PROVIDER=demo
BINANCE_BASE_URL=https://api.binance.com

# Twelve Data — set from the plan you sign (verify on the pricing page; see docs/03 for the credit estimate)
TWELVEDATA_API_KEY=
TWELVEDATA_PLAN=                # label shown on the admin sheet, e.g. grow / pro
TWELVEDATA_CREDITS_PER_MINUTE=8 # Basic 8 · Grow 55 · Pro 610 · Ultra 1500 — keep ~20% below the plan cap
TWELVEDATA_WS=false             # true only on plans that include WebSocket streaming
TWELVEDATA_POLL_SECONDS=15      # polling interval when TWELVEDATA_WS=false

# Polygon.io — US stocks / indices / forex / crypto
POLYGON_API_KEY=
POLYGON_PLAN=
POLYGON_REQUESTS_PER_MINUTE=5   # free tier 5; paid plans are unlimited — set e.g. 300
POLYGON_WS=false
POLYGON_POLL_SECONDS=15

# ── Economic calendar / news (optional) ──────────────────────
NEWS_PROVIDER=none
NEWS_API_KEY=

# ── AI (explanation + chat). Detection never depends on the LLM ──
AI_PROVIDER=anthropic          # anthropic | none  (none → deterministic explainer only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1024

# ── Alerts & notifications (NOTIF-01) ────────────────────────
ALERT_WATCH_ENABLED=true        # server-side watcher: alerts fire with no browser open
ALERT_POLL_SECONDS=15           # how often active alerts are checked against the last 1m bars
# Web Push (VAPID). Generate once: pnpm --filter @tradingworld/api vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
# Email. Empty = email channel off. e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="TradingWorld <alerts@example.com>"
APP_URL=http://localhost:3000   # links in push/email; defaults to the first CORS origin

# ── Backups (OPS-02, docs/13-backups.md) ─────────────────────
BACKUP_DIR=./backups
BACKUP_AT=02:30                 # daily, UTC
BACKUP_DRILL=weekly             # daily | weekly | off — restore drill into a scratch database
BACKUP_DRILL_URL=               # CREATE DATABASE rights; default: DATABASE_URL's server
BACKUP_AGE_RECIPIENTS=          # age1…,age1… (age-keygen); empty = NOT encrypted
BACKUP_AGE_IDENTITY_FILE=       # private key, only where drills/restores run
BACKUP_RCLONE_REMOTE=           # e.g. r2:tradingworld-backups/db + RCLONE_CONFIG_R2_* (see docs/13)
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_MAX_AGE_HOURS=26
BACKUP_DRILL_MAX_AGE_DAYS=8

# ── Web app ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_DEFAULT_LOCALE=ar
