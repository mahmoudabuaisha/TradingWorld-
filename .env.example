# ─────────────────────────────────────────────────────────────
# TradingWorld — environment template (copy to .env, never commit .env)
# ─────────────────────────────────────────────────────────────

# ── API server ───────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
# 32+ random chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ── Database (PostgreSQL + TimescaleDB) ──────────────────────
DATABASE_URL=postgresql://tradingworld:tradingworld@localhost:5432/tradingworld?schema=public
REDIS_URL=redis://localhost:6379

# ── Market data providers ────────────────────────────────────
# demo    → deterministic synthetic candles (no key, offline, for development)
# binance → public Binance REST/WS (crypto only, check ToS before commercial use)
# twelvedata / polygon → licensed providers (keys required)
MARKET_DATA_PROVIDER=demo
BINANCE_BASE_URL=https://api.binance.com
TWELVEDATA_API_KEY=
POLYGON_API_KEY=

# ── Economic calendar / news (optional) ──────────────────────
NEWS_PROVIDER=none
NEWS_API_KEY=

# ── AI (explanation + chat). Detection never depends on the LLM ──
AI_PROVIDER=anthropic          # anthropic | none  (none → deterministic explainer only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1024

# ── Web app ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_DEFAULT_LOCALE=ar
