{
  "name": "@tradingworld/api",
  "version": "0.1.0",
  "private": true,
  "description": "TradingWorld API gateway — auth, market data adapters, analysis service, alerts, journal, AI explanation, realtime WebSocket.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "feed:check": "node dist/tools/feed-check.js",
    "backfill": "node dist/tools/backfill.js",
    "vapid-keys": "node dist/tools/vapid-keys.js",
    "backup": "node dist/tools/backup.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "@tradingworld/analysis-engine": "workspace:*",
    "@tradingworld/db": "workspace:*",
    "@tradingworld/shared": "workspace:*",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
