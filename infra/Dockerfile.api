# ── Build stage ──────────────────────────────────────────────
FROM node:22-alpine AS build
RUN corepack enable && apk add --no-cache openssl
WORKDIR /repo
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter './packages/*' build && pnpm --filter @tradingworld/api build

# ── Runtime stage ────────────────────────────────────────────
FROM node:22-alpine
# OPS-02: the same image runs the backup job (docker-compose service `backup`). pg_dump must be at least the server's
# major version (docker-compose runs PostgreSQL 16); age encrypts the dumps, rclone copies them offsite.
RUN corepack enable && apk add --no-cache openssl postgresql16-client age rclone
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=build /repo ./
EXPOSE 4000
# With a database: apply Prisma migrations (idempotent) before starting; without one the API runs on memory repositories.
CMD ["sh", "-c", "if [ -n \"$DATABASE_URL\" ]; then pnpm --filter @tradingworld/db migrate:deploy || exit 1; fi; exec node apps/api/dist/server.js"]
