# DEPLOY-01 — one domain, automatic HTTPS (Let's Encrypt). The browser talks to its own origin: /api/* and /ws go to the
# API, /grafana to the dashboards (OPS-01b), everything else to the web app. Caddy sets X-Forwarded-For itself (a client
# cannot forge it), which the API's rate limits and logs rely on. deploy.sh reloads Caddy when this file changes.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@api path /api/* /ws
	handle @api {
		reverse_proxy api:4000
	}

	# the API's Prometheus endpoint is for the internal network only: Prometheus scrapes it there
	handle /metrics {
		respond 404
	}

	# OPS-01b: Grafana, behind its own login; Prometheus, Jaeger and the node exporter have no route at all
	@grafana path /grafana /grafana/*
	handle @grafana {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
