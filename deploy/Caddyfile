# DEPLOY-01 — one domain, automatic HTTPS (Let's Encrypt). The browser talks to its own origin: /api/* and /ws go to the
# API, everything else to the web app. Caddy sets X-Forwarded-For itself (a client cannot forge it), which the API's
# rate limits and logs rely on.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@api path /api/* /ws
	handle @api {
		reverse_proxy api:4000
	}

	# the API's Prometheus endpoint is for the internal network only (OPS-01 monitoring profile)
	handle /metrics {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
